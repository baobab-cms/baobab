APP_NAME="Baobab CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# En production : APP_ENV=production et APP_DEBUG=false.
# L'installateur le vérifie et avertit si l'URL est publique avec le debug actif
# (spec 15 §7).

# Les traductions du framework (validation, auth, mots de passe, pagination)
# sont versionnées dans `lang/`, publiées depuis `laravel-lang` : Laravel ne
# fournit plus de `lang/` par défaut, et une locale sans fichiers affiche ses
# messages en clés brutes — `validation.unique` sous le champ (suivi n° 204).
# Changer de locale suppose donc de publier la sienne : php artisan lang:add <locale>
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite convient à l'évaluation et à la préproduction ; il est refusé en
# production par l'installateur (spec 15 §8, décision 3).
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=baobab
# DB_USERNAME=root
# DB_PASSWORD=

# --- Baobab -----------------------------------------------------------------
# Réglages du CMS. Tous ont un défaut sain dans config/baobab.php : ne renseigner
# que ce qui doit s'en écarter.

BAOBAB_MEDIA_TRASH_RETENTION_DAYS=10
#BAOBAB_MEDIA_DISK=public
#BAOBAB_MEDIA_MAX_UPLOAD_SIZE=
#BAOBAB_MEDIA_CHUNK_SIZE=
#BAOBAB_MEDIA_DUPLICATE_BEHAVIOR=
#BAOBAB_MEDIA_IMAGE_DRIVER=
#BAOBAB_MEDIA_AVIF_ENABLED=false
#BAOBAB_MEDIA_JOB_MEMORY_LIMIT=
#BAOBAB_CONTENT_TYPES_PATH=modules
#BAOBAB_LOG_RETENTION_DAYS=14
#BAOBAB_IMPERSONATION_MINUTES=60
#BAOBAB_ADMIN_PATH=admin
#BAOBAB_MODULE_UPLOAD_PATH=
#BAOBAB_THEME_UPLOAD_PATH=
#BAOBAB_MODULE_UPLOAD_MAX_SIZE=
# ----------------------------------------------------------------------------

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Baobab envoie ses e-mails par la queue dédiée `baobab` (spec 13 §2) : un worker
# ou une tâche cron doit tourner, faute de quoi rien ne part. L'écran final de
# l'installateur donne la marche à suivre pour l'hébergement détecté.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
